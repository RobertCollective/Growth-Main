---
import '../styles/global.css';

// Browser tab and social share previews always use the "GROWTH Tour — …" form.
const {
  title = 'GROWTH Tour',
  description = 'GROWTH brings business, AI, and wealth together.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050405" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GROWTH Tour" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
