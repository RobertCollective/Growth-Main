---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page not found | GROWTH Tour" description="The page you requested could not be found.">
  <main class="container" style="padding: 6rem 0 8rem;">
    <div style="max-width: 42rem; margin: 0 auto; text-align: center;">
      <p class="kicker">404</p>
      <h1 style="font-size: clamp(2.5rem, 10vw, 5rem); text-transform: uppercase; letter-spacing: -0.06em; margin: 0 0 1rem;">This city isn’t on the map yet.</h1>
      <p style="color: var(--muted); margin-bottom: 2rem;">The page you requested is missing, but the next GROWTH stop is still waiting.</p>
      <a class="button primary" href="/">Return home</a>
    </div>
  </main>
</SiteLayout>
