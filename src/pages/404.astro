---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Growth Tour — Page not found" description="The page you requested could not be found.">
  <header class="site-header">
    <div class="container">
      <a class="brand" href="/">
        <span class="brand-mark"></span>
        <span>Growth</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/#tour">Tour</a>
        <a href="/#speakers">Speakers</a>
        <a href="/#tickets">Tickets</a>
        <a href="/#faq">FAQs</a>
      </nav>
    </div>
  </header>
  <main class="container city-page">
    <p class="kicker">404</p>
    <h1>Page not found.</h1>
    <p style="color: var(--muted); margin-bottom: 2rem;">The page you requested is missing, but the next Growth stop is still waiting.</p>
    <a class="button primary" href="/">Return home</a>
  </main>
</SiteLayout>
