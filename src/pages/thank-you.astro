---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Thanks for reaching out | GROWTH Tour" description="Thanks for your interest in GROWTH Tour.">
  <main class="container" style="padding: 6rem 0 8rem;">
    <div style="max-width: 42rem; margin: 0 auto; text-align: center;">
      <p class="kicker">Thanks</p>
      <h1 style="font-size: clamp(2.5rem, 10vw, 5rem); text-transform: uppercase; letter-spacing: -0.06em; margin: 0 0 1rem;">Your interest is on the list.</h1>
      <p style="color: var(--muted); margin-bottom: 2rem;">This is a static prototype form. In production, this would be connected to HubSpot or your ticketing provider.</p>
      <a class="button primary" href="/">Back to the site</a>
    </div>
  </main>
</SiteLayout>
